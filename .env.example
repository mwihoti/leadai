VITE_AI_PROVIDER=anthropic
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
VITE_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
VITE_ENABLE_GROQ_FALLBACK=true
VITE_TELEGRAM_API_URL=/api

# Groq fallback:
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Optional provider alternatives:
# VITE_AI_PROVIDER=groq
# VITE_AI_PROVIDER=gemini
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
# VITE_GEMINI_MODEL=gemini-1.5-flash

# Server-only Telegram reminder backend:
# Run with: npm run server
DATABASE_URL=your_neon_database_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_PORT=8787
TELEGRAM_DATA_FILE=./data/telegram-store.json

# Optional server-side AI for Telegram /post commands:
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
